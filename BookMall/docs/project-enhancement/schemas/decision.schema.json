{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmall.local/schema/after-sale-decision.json",
  "title": "After-sale Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "action", "amount", "reason", "riskLevel", "evidenceIds", "policyVersion", "nextStep"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["LOGISTICS_NOT_RECEIVED", "DAMAGED", "MISSING_ITEM", "REFUND_REQUEST", "GENERAL_INQUIRY", "UNKNOWN"]
    },
    "action": {
      "type": "string",
      "enum": ["NO_ACTION", "REQUEST_INFO", "REFUND", "COMPENSATE", "NEEDS_HUMAN", "REJECT"]
    },
    "amount": {"type": "number", "minimum": 0},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "riskLevel": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "evidenceIds": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}},
    "policyVersion": {"type": "string", "pattern": "^v[0-9]+$"},
    "nextStep": {"type": "string", "enum": ["UNDER_REVIEW", "WAITING_USER", "WAITING_APPROVAL", "PROCESSING", "RISK_REVIEW", "REJECTED"]}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "REFUND"}}},
      "then": {"properties": {"amount": {"exclusiveMinimum": 0}}}
    }
  ]
}
